/*------------------------------------------------------------------------------

constant/speciesTransportProperties

  - list of transported gaseous species
  - physical transport properties of each species

------------------------------------------------------------------------------*/
FoamFile{version 2.0;  format ascii;  class dictionary; object speciesTransportProperties;}
/*----------------------------------------------------------------------------*/

species
(
  PbI2_g
  tracer
);

PbI2_g {

  D               1e-5;          /* molecular diffusivity [m2/s] */
  molarMass       0.46100894;    /* kg/mol; enables c_PbI2_g output */
}

tracer {

  D               1e-5;          /* same D as PbI2_g for validation */
}
