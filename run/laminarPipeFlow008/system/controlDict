/*------------------------------------------------------------------------------

system/controlDict

  - select solver
  - start and stop of calculation
  - time step size
  - saving frequency
  - output format, precision, compression and time naming
  - allows run-time changes
  - extra functions

------------------------------------------------------------------------------*/
FoamFile{version 2.0;  format ascii;  class dictionary; object controlDict;}
/*----------------------------------------------------------------------------*/

application     rhoFreezeFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         16.0;            /* flow through time is ~ 7.3 s */

deltaT          0.004;           /* results in CFL ~ 0.47 */

writeControl    timeStep;
writeInterval   50;

purgeWrite      0;

writeFormat     binary;
writeCompression off;

timeFormat      general;
timePrecision   12;

runTimeModifiable true;

functions {

    writeTransportProperties {

        type            coded;
        libs            ("libutilityFunctionObjects.so");
        name            writeTransportProperties;

        writeControl    writeTime;

        codeInclude
        #{
            #include "fvCFD.H"
            #include "fluidThermo.H"
        #};

        codeOptions
        #{
            -I$(LIB_SRC)/thermophysicalModels/basic/lnInclude  \
            -I$(LIB_SRC)/thermophysicalModels/specie/lnInclude  \
            -I$(LIB_SRC)/transportModels/compressible/lnInclude
        #};

        codeLibs
        #{
            -lfluidThermophysicalModels  \
            -lspecie
        #};

        codeWrite
        #{
            const fluidThermo& thermo =
                mesh().lookupObject<fluidThermo>("thermophysicalProperties");

            volScalarField muField (
                IOobject (
                    "mu",
                    mesh().time().timeName(),
                    mesh(),
                    IOobject::NO_READ,
                    IOobject::NO_WRITE
                ),
                thermo.mu()
            );

            volScalarField kappaField (
                IOobject (
                    "kappa",
                    mesh().time().timeName(),
                    mesh(),
                    IOobject::NO_READ,
                    IOobject::NO_WRITE
                ),
                thermo.kappa()
            );

            muField.write();
            kappaField.write();
        #};
    }

    Pb_gTransport {
        type            scalarTransport;
        libs            ("libsolverFunctionObjects.so");

        field           Pb_g;
        phi             phi;
        rho             rho;

        D               1e-5;

        schemesField    Pb_g;

        /* Is it limited between 0 and 1 ? */
        bounded01       no;
        resetOnStartUp  no;

        tolerance       1.0e-7;
        nCorr           47;

        writeControl    writeTime;
        writeInterval   1;
    }
}
