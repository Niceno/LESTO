FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setExprFieldsDict;
}

expressions
(
    parabolicVelocity
    {
        field       U;
        expression
        "vector(0.19*(1 - (sqr(pos().y()) + sqr(pos().z()))/sqr(0.0024)), 0, 0)";
    }

    linearTemperature
    {
        field       T;

        /*-------------------------+
        |  x = 0.0   =>  T = 1000  |
        |  x = 0.69  =>  T =  300  |
        +-------------------------*/
        expression  "1000 - (700/0.69)*pos().x()";
    }
);
