FoamFile {format ascii;  class volScalarField;  object T;}

dimensions      [0 0 0 1 0 0 0];

// Temporary value; internal field is overwritten by setExprFields
internalField   uniform 400;

boundaryField {

  INLET {
    type    fixedValue;
    value   uniform 400;
  }

  OUTLET {
    type    zeroGradient;
  }

  WALL {
    type    codedFixedValue;
    value   uniform 400;
    name    linearWallTemperature;

    code
    #{
      const vectorField& Cf = patch().Cf();

      forAll(Cf, facei) {
        const scalar x = Cf[facei].x();

        operator[](facei) =
          400.0 - 100.0*x/0.69;
      }
    #};
  }
}

